{
  "name": "cloudpanel-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that lets an AI assistant manage CloudPanel v2 servers through the official clpctl CLI: read-only by default, every change approved by you, the SSH key locked to a gate. Unofficial.",
  "homepage": "https://github.com/dasocreative/cloudpanel-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasocreative/cloudpanel-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/dasocreative/cloudpanel-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudpanel",
    "clpctl",
    "server-administration",
    "ai-agents",
    "security",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "devops",
    "web-hosting"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "cloudpanel-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "hardening/cloudpanel-mcp-gate.sh",
    "hardening/cloudpanel-mcp-setup.sh",
    "inventory/cloudpanel-mcp-inventory",
    "docs/*.md",
    "docs/adr/*.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run typecheck && node --test --test-timeout=180000 --test-reporter=spec \"test/**/*.test.ts\"",
    "mutation": "npm run build && node scripts/mutation-check.mjs",
    "gen:gate": "node scripts/gen-gate.ts",
    "gen:docs": "node scripts/gen-docs.ts",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "contract-test": "node scripts/contract-test.mjs",
    "prepublishOnly": "npm run build",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
